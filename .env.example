# =============================================================================
# Local AI Business Advisor - environment configuration
#
# Copy this file to `.env` and adjust values:   cp .env.example .env
# NEVER commit the real `.env` file. Only this template belongs in version
# control, so secrets and machine-specific paths stay out of the repository.
# Every variable is optional: the defaults in app/core/config.py are used
# when a variable is missing.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Local AI Business Advisor"
APP_VERSION=0.1.0
# One of: development | testing | production
ENVIRONMENT=development
# Never enable DEBUG in production (the app refuses to start if you do).
DEBUG=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- API server (FastAPI) ----------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Where the Streamlit frontend finds the backend.
API_BASE_URL=http://127.0.0.1:8000
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Database (SQLite) -------------------------------------------------------
# Relative sqlite paths are resolved against the project root (not the current
# working directory), so the app finds the same DB no matter where it is started.
DATABASE_URL=sqlite:///./data/advisor.db
# Set to true to log every SQL statement (very noisy, debugging only).
DATABASE_ECHO=false

# --- Ollama (local LLM) ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# 0.0 = deterministic, higher = more creative. Business advice favours low values.
OLLAMA_TEMPERATURE=0.2
# Seconds to wait for the local model. Local inference on CPU can be slow.
OLLAMA_REQUEST_TIMEOUT=120

# --- Vector store (ChromaDB) -------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=business_documents

# --- Document uploads --------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25
# Comma-separated, lowercase, with leading dot.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.csv,.xlsx,.txt

# --- Chat behaviour ----------------------------------------------------------
# How many recent messages are sent to the LLM as context (limits token use).
CHAT_HISTORY_WINDOW=10
# Hard cap on a single user message, protects the model and the database.
MAX_MESSAGE_LENGTH=8000
